# Параметры подключения к СУБД PostgreSQL 16+
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/booking_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Настройки контейнера PostgreSQL для docker-compose.yml
POSTGRES_DB=booking_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Таймзона и валюта заведения (ADR-007, ADR-009)
APP_TIMEZONE=Europe/Moscow
APP_CURRENCY=RUB

# Bootstrap-аккаунт администратора (создаётся при первом запуске)
APP_BOOTSTRAP_ADMIN_EMAIL=admin@booking.local
APP_BOOTSTRAP_ADMIN_PASSWORD=admin12345

# Инициализация синтетических демонстрационных данных для жюри (true / false)
APP_DEMO_SEED_ENABLED=true

# Настройки безопасности сессионной cookie (в production с HTTPS установить true)
SESSION_COOKIE_SECURE=false
